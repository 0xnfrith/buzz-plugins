{
  "compilerOptions": {
    "target": "ES2022",
    "lib": [
      "ES2023",
      "DOM",
      "DOM.Iterable"
    ],
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "resolveJsonModule": true,
    "allowJs": true,
    "types": [
      "node"
    ],
    "strict": true,
    "noEmit": true,
    "jsx": "react"
  },
  "include": [
    "src",
    "test/unit",
    "test/bench/bench.ts", "test/bench/types.d.ts"
  ]
}
