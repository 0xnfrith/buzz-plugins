{
  "id": "megatech.ghost-protocol",
  "name": "GHOST Protocol",
  "apiVersion": 1,
  "description": "Makes a GHOST Protocol agent in Docker on your computer from New agent, and shows how it is doing: its state, version and relay, with Update, Roll back, Restart and Stop. Needs Docker Desktop.",
  "discovery": {
    "category": "agents",
    "tags": ["GHOST Protocol", "Docker", "Agents"]
  },
  "host": {
    "commands": [{ "id": "version", "program": "docker", "args": ["version", "--format", "{{.Server.Version}}"] }],
    "processes": [
      { "id": "pull", "program": "docker", "args": ["pull", "ghcr.io/0xnfrith/ghost-protocol:0.15.2@sha256:256dda44a35cdc8306cccd940e66066fb614bad4ecd2d259066d8d32cf84acc0"] },
      { "id": "run-init", "program": "docker", "args": ["run", "--rm", "-v"] },
      { "id": "run-agent", "program": "docker", "args": ["run", "-d", "--restart", "unless-stopped", "--name"] },
      { "id": "run-updater", "program": "docker", "args": ["run", "-d", "--restart", "unless-stopped", "-v", "/var/run/docker.sock:/var/run/docker.sock", "--name"] },
      { "id": "exec", "program": "docker", "args": ["exec"] },
      { "id": "inspect-state", "program": "docker", "args": ["inspect", "--format", "{{.State.Status}}"] },
      { "id": "inspect-image", "program": "docker", "args": ["inspect", "--format", "{{.Config.Image}}"] },
      { "id": "restart", "program": "docker", "args": ["restart"] },
      { "id": "stop", "program": "docker", "args": ["stop"] },
      { "id": "rm", "program": "docker", "args": ["rm", "-f"] },
      { "id": "volume-rm", "program": "docker", "args": ["volume", "rm"] }
    ]
  }
}
