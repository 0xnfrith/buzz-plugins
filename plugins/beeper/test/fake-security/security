#!/usr/bin/env node
// A stand-in for the `security` program of macOS, enough for the plugin's three commands. It follows how that
// program is documented and remembered to behave, NOT how it was seen to behave (there was no Mac to see it on):
//   find-generic-password -s S -a A -w     prints the password and a line break; exit 44 when there is no such item
//   add-generic-password -U -s S -a A -w   with -w last and no value, asks for the password twice on stdin (a terminal
//                                          prompt; with no terminal the C library reads stdin), exit 1 if they differ
//   add-generic-password ... -w VALUE      takes the password from the command line (the plugin never does this)
//   delete-generic-password -s S -a A      exit 44 when there is no such item
// Environment: BEEPER_FAKE_KEYCHAIN is the file the "keychain" is kept in, BEEPER_FAKE_KEYCHAIN_LOG gets one JSON line
// with the arguments of each call, BEEPER_FAKE_KEYCHAIN_MODE is "refuse-add" (adding always fails) or "slow" (every
// call takes BEEPER_FAKE_KEYCHAIN_DELAY milliseconds first, for a test that reads the process list meanwhile).
import fs from "node:fs";

const file = process.env.BEEPER_FAKE_KEYCHAIN;
const args = process.argv.slice(2);
if (process.env.BEEPER_FAKE_KEYCHAIN_LOG) fs.appendFileSync(process.env.BEEPER_FAKE_KEYCHAIN_LOG, JSON.stringify(args) + "\n");
if (process.env.BEEPER_FAKE_KEYCHAIN_MODE === "slow") await new Promise((resolve) => setTimeout(resolve, Number(process.env.BEEPER_FAKE_KEYCHAIN_DELAY ?? 1000)));

const load = () => {
  try {
    return JSON.parse(fs.readFileSync(file, "utf8"));
  } catch {
    return {};
  }
};
const flag = (name) => {
  const at = args.indexOf(name);
  return at < 0 ? undefined : args[at + 1];
};
const key = `${flag("-s") ?? ""}\u0000${flag("-a") ?? ""}`;
const missing = () => {
  process.stderr.write("security: SecKeychainSearchCopyNext: The specified item could not be found in the keychain.\n");
  process.exit(44);
};

const [command] = args;
if (command === "find-generic-password") {
  const items = load();
  if (!(key in items)) missing();
  if (args.includes("-w")) process.stdout.write(items[key] + "\n");
} else if (command === "add-generic-password") {
  if (process.env.BEEPER_FAKE_KEYCHAIN_MODE === "refuse-add") {
    process.stderr.write("security: SecKeychainItemCreateFromContent: User interaction is not allowed.\n");
    process.exit(36);
  }
  let password;
  const at = args.indexOf("-w");
  if (at >= 0 && at < args.length - 1) password = args[at + 1];
  else if (at === args.length - 1) {
    const lines = fs.readFileSync(0, "utf8").split("\n");
    if (lines.length < 2 || lines[0] === "" || lines[0] !== lines[1]) {
      process.stderr.write("security: passwords don't match\n");
      process.exit(1);
    }
    password = lines[0];
  } else {
    process.stderr.write("security: no password given\n");
    process.exit(1);
  }
  const items = load();
  if (key in items && !args.includes("-U")) {
    process.stderr.write("security: SecKeychainItemCreateFromContent: The specified item already exists in the keychain.\n");
    process.exit(45);
  }
  items[key] = password;
  fs.writeFileSync(file, JSON.stringify(items));
} else if (command === "delete-generic-password") {
  const items = load();
  if (!(key in items)) missing();
  delete items[key];
  fs.writeFileSync(file, JSON.stringify(items));
} else {
  process.stderr.write(`security: unknown command ${command}\n`);
  process.exit(2);
}
