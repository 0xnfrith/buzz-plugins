#!/usr/bin/env node
// A stand-in for `secret-tool` (libsecret-tools, the Linux Secret Service), enough for the plugin's three commands. What it does
// follows what the real program (0.21.4) was seen to do on a machine with an unlocked gnome-keyring:
//   store --label=L service S account A   reads standard input to the end and keeps all of it, a trailing line break included;
//                                         replaces an item with the same attributes; exit 0
//   lookup service S account A            prints the secret and nothing else (no line break); exit 1 and no output when there is none
//   clear service S account A             exit 0 when it removed an item, exit 1 when none matched
// Environment: LINEAR_FAKE_SECRET is the file the store is kept in, LINEAR_FAKE_SECRET_LOG gets one JSON line with the arguments of
// each call, LINEAR_FAKE_SECRET_MODE is
//   "unreachable"   every call fails (no Secret Service on the bus, a locked collection nobody answers for)
//   "refuse-store"  storing always fails
//   "refuse-clear"  clearing always fails
//   "mismatch"      storing says nothing and keeps something else (a read-back that does not match)
//   "slow"          every call takes LINEAR_FAKE_SECRET_DELAY milliseconds first, for a test that reads the process list meanwhile
import fs from "node:fs";

const file = process.env.LINEAR_FAKE_SECRET;
const args = process.argv.slice(2);
if (process.env.LINEAR_FAKE_SECRET_LOG) fs.appendFileSync(process.env.LINEAR_FAKE_SECRET_LOG, JSON.stringify(args) + "\n");
const mode = process.env.LINEAR_FAKE_SECRET_MODE;
if (mode === "slow") await new Promise((resolve) => setTimeout(resolve, Number(process.env.LINEAR_FAKE_SECRET_DELAY ?? 1000)));

const fail = (message) => {
  process.stderr.write(`secret-tool: ${message}\n`);
  process.exit(1);
};
if (mode === "unreachable") fail("Cannot autolaunch D-Bus without X11 $DISPLAY");

const load = () => {
  try {
    return JSON.parse(fs.readFileSync(file, "utf8"));
  } catch {
    return {};
  }
};
const [command, ...rest] = args;
const attributes = rest.filter((arg) => !arg.startsWith("--"));
const pairs = [];
for (let i = 0; i + 1 < attributes.length; i += 2) pairs.push(`${attributes[i]}=${attributes[i + 1]}`);
const key = pairs.sort().join("\u0000");

if (command === "store") {
  if (mode === "refuse-store") fail("Cannot create an item in a locked collection");
  if (!rest.some((arg) => arg.startsWith("--label"))) fail("a label is required");
  let secret = fs.readFileSync(0, "utf8");
  if (mode === "mismatch") secret = `${secret}-kept-differently`;
  const items = load();
  items[key] = secret;
  fs.writeFileSync(file, JSON.stringify(items));
} else if (command === "lookup") {
  const items = load();
  if (!(key in items)) process.exit(1);
  process.stdout.write(items[key]);
} else if (command === "clear") {
  if (mode === "refuse-clear") fail("Cannot remove an item in a locked collection");
  const items = load();
  if (!(key in items)) process.exit(1);
  delete items[key];
  fs.writeFileSync(file, JSON.stringify(items));
} else {
  process.stderr.write(`secret-tool: unknown command ${command}\n`);
  process.exit(2);
}
