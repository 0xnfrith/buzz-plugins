{
  "id": "megatech.linear",
  "name": "Linear",
  "apiVersion": 1,
  "description": "Your Linear board inside Buzz: a column for each workflow state, drag a card to change its state.",
  "discovery": {
    "category": "developer-tools-and-integrations",
    "tags": ["Linear", "Kanban", "Issues"]
  },
  "host": {
    "commands": [
      {
        "id": "keychain-read",
        "program": "security",
        "args": [
          "find-generic-password",
          "-s",
          "buzz-linear",
          "-a",
          "linear",
          "-w"
        ]
      },
      {
        "id": "keychain-save",
        "program": "security",
        "args": [
          "add-generic-password",
          "-U",
          "-s",
          "buzz-linear",
          "-a",
          "linear",
          "-w"
        ],
        "maxInputBytes": 2048
      },
      {
        "id": "keychain-delete",
        "program": "security",
        "args": [
          "delete-generic-password",
          "-s",
          "buzz-linear",
          "-a",
          "linear"
        ]
      }
    ],
    "networkOrigins": ["https://api.linear.app"]
  }
}
